{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^9.0.0",
    "framer-motion": "^12.38.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alihsan.shareeath",
    "productName": "Al Ihsan Shareeath College",
    "files": [
      "out/**/*",
      "electron/electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.bin",
          "!node_modules/**/.git",
          "!.env"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
